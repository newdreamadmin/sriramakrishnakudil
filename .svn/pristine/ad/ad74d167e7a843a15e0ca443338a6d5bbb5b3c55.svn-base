<!-- Start Donate -->
					<section id="mu-donate">
					<div class="container">
						<div class="row">
						<div class="col-md-12">

							<!-- Title -->
							<div class="mu-donate-title text-center">
							<h2>Donate to Sri Ramakrishna Kudil</h2>
							<p>
								Sri Ramakrishna Kudil, Thirupparaithurai, is a charitable educational
								institution founded in 1949 with the noble vision of uplifting
								underprivileged children through value-based education, discipline,
								and self-reliance. For over seven decades, the Kudil has been serving
								society by shaping young lives into responsible, spiritually rooted
								citizens.
							</p>
							<p><strong>Your generous contribution helps us continue this sacred mission.</strong></p>
							</div>

							<!-- Why Donation Matters -->
							<div class="mu-donate-section">
							<h4>Why Your Donation Matters</h4>
							<ul>
								<li>Free and subsidized education for poor and needy boys</li>
								<li>Food, clothing, shelter, and healthcare for resident students</li>
								<li>Character building based on the ideals of Sri Ramakrishna, Holy Mother Sarada Devi, and Swami Vivekananda</li>
								<li>Maintenance and development of school infrastructure</li>
								<li>Supporting teachers, caretakers, and educational activities</li>
							</ul>
							<p><strong>Every donation, big or small, becomes a building block in a child’s future.</strong></p>
							</div>

							<!-- Ways You Can Support -->
							<div class="mu-donate-section">
							<h4>Ways You Can Support</h4>
							<ul>
								<li>Student education sponsorship</li>
								<li>Hostel and food expenses</li>
								<li>Classroom and library development</li>
								<li>Infrastructure and building maintenance</li>
								<li>General welfare and institutional growth</li>
							</ul>
							<p>
								All donations are utilized transparently for the welfare of the
								children and the institution.
							</p>
							</div>

							<!-- Suggested Donation Options -->
							<div class="mu-donate-section">
							<h4>Suggested Donation Options</h4>
							<ol>
								<li>Daily Food Support for Students – ₹3,000</li>
								<li>Educational Support for Students – ₹5,000</li>
								<li>Special Educational Needs Support – ₹10,000</li>
								<li>Annual Educational Assistance – ₹15,000</li>
								<li>Classroom / Infrastructure Development Support – ₹4,50,000</li>
								<li>Major Institutional Development Contribution – ₹54,00,000</li>
								<li>Construction Support for Institutional Facilities – ₹1,50,000</li>
								<li>Furniture & Basic Amenities Support – ₹40,000</li>
								<li>Student Welfare Support for 350 Students – ₹1,75,000</li>
								<li>Kitchen & Food Preparation Infrastructure Support – ₹75,000</li>
								<li>General Donation for Institutional Growth and Maintenance – Any Amount</li>
							</ol>
							<p>
								(Contributors may also donate an amount of their choice according to
								their willingness and capacity.)
							</p>
							<p>
								<strong>
								All contributions are utilized solely for the welfare, education,
								and holistic development of students at Sri Ramakrishna Kudil.
								</strong>
							</p>
							</div>

							<!-- Tax Benefit -->
							<div class="mu-donate-section">
							<h4>Tax Benefit (80G Exemption)</h4>
							<p>
								Donations made to Sri Ramakrishna Kudil are eligible for Income Tax
								exemption under Section 80G, as per Government of India norms.
								Donation receipts will be issued upon request.
							</p>
							</div>

							<!-- Bank Details -->
							<div class="mu-donate-section">
								<h4 class="text-center mb-4">Bank Account Details for Donation</h4>

								<p class="text-center mb-4">
									<strong>Account Name:</strong> Sri Ramakrishna Kudil, Thirupparaithurai
								</p>

								<div class="row">

									<!-- Canara Bank -->
									<div class="col-md-6 mb-4">
